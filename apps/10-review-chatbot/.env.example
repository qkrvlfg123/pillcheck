# RAG(쇼핑 리뷰 분석)를 쓰려면 아래 키를 넣고 .env 로 저장하세요.
# 약물 상담만 쓸 거면 키 없어도 됩니다.

# Gemini (임베딩 + 답변 생성) - https://aistudio.google.com/apikey (무료)
GEMINI_API_KEY=

# Pinecone (벡터DB) - https://pinecone.io (무료 티어)
PINECONE_API_KEY=

# (선택) 식약처 DUR - 약물 상담을 공식 데이터로 보강
#   /drug-check 에 {"use_dur": true} 를 보내면 서버가 이 키로 식약처 DUR을 조회한다.
#   키는 서버에서만 쓰이고 응답에 노출되지 않는다(프록시). 없으면 로컬 규칙만 사용.
#   발급: data.go.kr → 'DUR품목정보'(15059486) + '의약품 제품 허가정보'(15095677) 활용신청(무료·자동승인)
DUR_SERVICE_KEY=
